# Copie este arquivo para .env.local e preencha somente na sua máquina ou servidor.
# Nunca versione .env.local.

NVIDIA_API_KEY=COLOQUE_SUA_CHAVE_NVIDIA
VEX_API_KEY=COLOQUE_SUA_CHAVE_VEX
VEX_SITE=https://vexapi.com.br

# BunnyFy. O token é provisionado fora do Git. Use `primary` somente durante
# a janela controlada; depois do smoke e da observação, troque para `exclusive`.
BUNNYFY_BASE_URL=https://api.exemplo.invalid
BUNNYFY_API_TOKEN=COLOQUE_SUA_CHAVE_BUNNYFY
BUNNYFY_ENABLED=false
# Exceção temporária e restrita à allocation atual da VexHost.
# Mantenha false em qualquer outro ambiente e remova após migrar para HTTPS.
BUNNYFY_ALLOW_INSECURE_HTTP=false
BUNNYFY_AI_MODE=off
BUNNYFY_AI_TIMEOUT_MS=130000
# Rollout independente do play/ytmp3: off, primary ou exclusive.
BUNNYFY_YOUTUBE_MODE=off
BUNNYFY_YOUTUBE_TIMEOUT_MS=190000
BUNNYFY_YOUTUBE_MAX_BYTES=52428800
BUNNYFY_YOUTUBE_MAX_CONCURRENCY=1
# Resolve busca textual no próprio bot para entregar URL canônica ao fallback
# temporário da BunnyFy; não baixa mídia pelo caminho legado.
BUNNYFY_YOUTUBE_RESOLVE_QUERY_LOCALLY=true
# Rollouts independentes das capacidades já disponíveis: off, primary ou exclusive.
BUNNYFY_IMAGES_MODE=off
BUNNYFY_CANVAS_MODE=off
BUNNYFY_LOGOS_MODE=off
BUNNYFY_GAMES_MODE=off
# primary: tenta a BunnyFy e cai para a Vex (transcribeAudioUrl) em falha transitória.
BUNNYFY_TRANSCRIPTION_MODE=off
# Downloaders sociais, um modo por plataforma. Facebook/Pinterest via yt-dlp;
# TikTok via tikwm.com (extrator nativo do yt-dlp bloqueado); Kwai via
# metadados da própria página pública.
BUNNYFY_FACEBOOK_MODE=off
BUNNYFY_PINTEREST_MODE=off
BUNNYFY_TIKTOK_MODE=off
BUNNYFY_KWAI_MODE=off
BUNNYFY_CAPABILITY_TIMEOUT_MS=120000
# Endereço futuro de planos/chaves. Enquanto vazio, a mensagem mostra apenas a marca.
BUNNYFY_ACCOUNT_URL=

# O GYOMEI também aceita nvidia_api_key, apikey_vex e site_vex em config.json,
# mas variáveis de ambiente são recomendadas para servidor e publicação.
