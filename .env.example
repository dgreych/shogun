# SHOGUN — configuração pública
# Copie para .env.local e preencha somente o que você usar.
# BunnyFy vem desligada e sem credencial por padrão.
# Nunca publique seu .env.local.

# --- Identidade ---
BOT_NAME=SHOGUN
DEFAULT_PERSONA=shogun
SHOGUN_LOW_MEMORY=false
SHOGUN_DEBUG=false

# --- IA / provedores ---
NVIDIA_API_KEY=

# --- BunnyFy opcional ---
BUNNYFY_ACCOUNT_URL=
BUNNYFY_AI_MODE=off
BUNNYFY_ALLOW_INSECURE_HTTP=false
BUNNYFY_API_TOKEN=
BUNNYFY_BASE_URL=
BUNNYFY_CANVAS_MODE=off
BUNNYFY_ENABLED=false
BUNNYFY_FACEBOOK_MODE=off
BUNNYFY_GAMES_MODE=off
BUNNYFY_IMAGES_MODE=off
BUNNYFY_IMAGE_GEN_MODE=off
BUNNYFY_KWAI_MODE=off
BUNNYFY_LOGOS_MODE=off
BUNNYFY_NEXO_RENDER_MODE=off
BUNNYFY_PINTEREST_MODE=off
BUNNYFY_STICKERS_MODE=off
BUNNYFY_TAVERN_RENDER_MODE=off
BUNNYFY_TIKTOK_MODE=off
BUNNYFY_TRANSCRIPTION_MODE=off
BUNNYFY_YOUTUBE_MODE=off

# --- Banco / Tavern ---
DATABASE_PATH=
NEXO_DATABASE_PATH=
TAVERN_DATABASE_CONFIG_PATH=
TAVERN_DATABASE_DRIVER=
TAVERN_DATABASE_PATH=
TAVERN_MYSQL_URL=

# --- Uploads / integrações auxiliares ---
UPLOAD_GITHUB_REPO=
UPLOAD_GITHUB_TOKEN=

# --- Outras variáveis detectadas ---
CONFIG_PATH=
IS_SUBBOT=
NOMEDONO=
NUMERODONO=
OWNER_NAME=
OWNER_NUMBER=
SHOGUN_CODE_MODE=
SHOGUN_OWNER_NAME=
SHOGUN_OWNER_NUMBER=
SUBBOT_ID=
BUNNYFY_YOUTUBE_TIMEOUT_MS=190000
BUNNYFY_YOUTUBE_MAX_BYTES=52428800
BUNNYFY_YOUTUBE_MAX_CONCURRENCY=4
