# SHOGUN — modelo de ambiente local
#
# A primeira instalação começa com `npm start`. Este arquivo existe como contrato técnico
# e molde para automação. Nunca versione .env.local nem credenciais reais.

# Identidade complementar da instância.
BOT_NAME=SHOGUN
DEFAULT_PERSONA=shogun

# BunnyFy é um serviço separado. O SHOGUN recebe somente a URL pública/privada
# autorizada para consumo e uma credencial de consumidor. Chaves internas de
# providers da BunnyFy nunca pertencem a este repositório.
BUNNYFY_BASE_URL=http://node1.vexhost.com.br:20056
BUNNYFY_API_TOKEN=
BUNNYFY_ENABLED=true

# Endereço oficial fixo. Não altere a URL: ela conecta todas as instâncias à BunnyFy.
BUNNYFY_ALLOW_INSECURE_HTTP=true

# Cada capacidade pode operar em: off, primary ou exclusive.
BUNNYFY_CONVERSATION_MODE=exclusive
BUNNYFY_YOUTUBE_MODE=exclusive
BUNNYFY_IMAGES_MODE=exclusive
BUNNYFY_STICKERS_MODE=exclusive
BUNNYFY_CANVAS_MODE=exclusive
BUNNYFY_LOGOS_MODE=exclusive
BUNNYFY_TRANSCRIPTION_MODE=exclusive
BUNNYFY_FACEBOOK_MODE=exclusive
BUNNYFY_PINTEREST_MODE=exclusive
BUNNYFY_TIKTOK_MODE=exclusive
BUNNYFY_KWAI_MODE=exclusive
BUNNYFY_GAMES_MODE=exclusive
BUNNYFY_IMAGE_GEN_MODE=exclusive
BUNNYFY_TAVERN_RENDER_MODE=exclusive
BUNNYFY_NEXO_RENDER_MODE=exclusive

# Limites e comportamento técnico por capacidade.
BUNNYFY_CONVERSATION_TIMEOUT_MS=130000
BUNNYFY_YOUTUBE_TIMEOUT_MS=190000
BUNNYFY_YOUTUBE_MAX_BYTES=52428800
BUNNYFY_YOUTUBE_MAX_CONCURRENCY=4
BUNNYFY_YOUTUBE_RESOLVE_QUERY_LOCALLY=true
BUNNYFY_CAPABILITY_TIMEOUT_MS=120000

# Endereço opcional para planos/chaves. Enquanto vazio, mensagens mostram apenas
# a marca sem inventar uma página comercial inexistente.
BUNNYFY_ACCOUNT_URL=https://wa.me/5522997028553

# Compatibilidade: versões históricas podem aceitar algumas credenciais também em
# config.json, mas novas instalações do SHOGUN devem usar o painel e .env.local.
