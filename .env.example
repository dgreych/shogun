# Identidade padrão do SHOGUN
BOT_NAME=𝖘𝖍𝖔𝖌𝖚𝖓
DEFAULT_PERSONA=shogun

# Recomendado para Termux e aparelhos com pouca memória.
SHOGUN_LOW_MEMORY=false

# Controles seguros do módulo de downloads.
BUNNYFY_YOUTUBE_MODE=off
BUNNYFY_YOUTUBE_TIMEOUT_MS=190000
BUNNYFY_YOUTUBE_MAX_BYTES=52428800
BUNNYFY_YOUTUBE_MAX_CONCURRENCY=4
